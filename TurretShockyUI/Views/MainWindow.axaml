<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:TurretShocky.ViewModels"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="using:TurretShocky.Models"
		xmlns:views="using:TurretShocky.Views"
		mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="570"
		x:Class="TurretShocky.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		Icon="/Assets/Shocky.ico"
		Title="TurretShocky"
		Height="570"
		Width="650"
		CanResize="False">

	<Design.DataContext>
		<!-- This only sets the DataContext for the previewer in an IDE,
		to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
		<vm:DesignMainWindowViewModel/>
	</Design.DataContext>
	<StackPanel Margin="4" Orientation="Vertical" Spacing="2">
		<StackPanel Spacing="5" Orientation="Horizontal" HorizontalAlignment="Center">
			<Image	Source="/Assets/Shocky.ico" Height="20" Margin="0,0,6,0"/>
			<TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="Bold">TurretShocky</TextBlock>
			<TextBlock Text="{Binding CurrentVersion}" VerticalAlignment="Center" FontSize="12"></TextBlock>
			<Button IsVisible="{Binding HasUpdateAvailable}" Click="OnUpdateClickBtn">
				<Button.Content>
					<StackPanel Orientation="Horizontal" Spacing="4">
						<TextBlock FontSize="12" VerticalAlignment="Center">Update available -> </TextBlock>
						<TextBlock FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Text="{Binding UpdateVersion}"></TextBlock>
					</StackPanel>
				</Button.Content>
			</Button>
		</StackPanel>
		<TextBlock HorizontalAlignment="Center" FontSize="12">A better app for the Smart Shock Collar asset</TextBlock>
		<TabbedPage Background="{DynamicResource BackgroundBrush}" >
			<ContentPage Header="Main" Background="{DynamicResource BackgroundBrush}">
				<views:MainTabView DataContext="{Binding}" Height="470"/>
			</ContentPage>
			<ContentPage Header="Shockers" Background="{DynamicResource BackgroundBrush}">
				<views:ShockersTabView DataContext="{Binding}" Height="470"/>
			</ContentPage>
			<ContentPage Header="Settings" Background="{DynamicResource BackgroundBrush}">
				<views:SettingsTabView DataContext="{Binding}" Height="470"/>
			</ContentPage>
		</TabbedPage>
	</StackPanel>
</Window>
